{
  "name": "alhuda-pos-app",
  "version": "1.0.29",
  "description": "Al Huda Point of Sale System",
  "main": "./out/main/index.js",
  "author": "Al Huda",
  "homepage": "https://alhuda.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "pretypecheck:node": "npx prisma generate",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --debug",
    "dev:web": "vite --host --config vite.renderer.config.ts",
    "build": "prisma generate && prisma migrate && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && prisma generate",
    "copy-prisma": "node scripts/copy-prisma-client.js",
    "build:unpack": "npm run build && npm run copy-prisma && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish=never",
    "build:mac": "npm run build && npm run copy-prisma && electron-builder --mac",
    "build:linux": "npm run build && npm run copy-prisma && electron-builder --linux",
    "studio": "npx prisma studio",
    "migrate": "npx prisma migrate dev && npx prisma generate"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/system": "^7.3.7",
    "@mui/x-date-pickers": "^8.26.0",
    "@prisma/adapter-better-sqlite3": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@react-google-maps/api": "^2.20.8",
    "@react-pdf/renderer": "^4.3.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tabler/icons-react": "^3.36.1",
    "axios": "^1.13.3",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.7.3",
    "env": "^0.0.2",
    "file-saver": "^2.0.5",
    "formik": "^2.4.9",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "moment": "^2.30.1",
    "motion": "^12.29.2",
    "react-component-export-image": "^1.0.6",
    "react-device-detect": "^2.2.3",
    "react-i18next": "^16.5.3",
    "react-leaflet": "^5.0.0",
    "react-perfect-scrollbar": "^1.5.8",
    "react-qr-code": "^2.0.18",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.0",
    "react-router-dom": "^7.13.0",
    "react-to-pdf": "^3.0.0",
    "recharts": "^3.7.0",
    "redux-persist": "^6.0.0",
    "styled-components": "^6.3.8",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1",
    "swiper": "^12.0.3",
    "yup": "^1.7.1",
    "yup-phone-lite": "^2.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sass-embedded": "^1.97.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
